<?xml version="1.0"?>
<Container version="2">
  <Name>CNGI-Core</Name>
  <Repository>ghcr.io/jabbadahutt762/jarvis-cngi-core:latest</Repository>
  <Registry>https://github.com/JabbaDaHutt762/Jarvis-CNGI-Core/pkgs/container/jarvis-cngi-core</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JabbaDaHutt762/Jarvis-CNGI-Core/issues</Support>
  <Project>https://github.com/JabbaDaHutt762/Jarvis-CNGI-Core</Project>
  <Overview>CNGI Core CRM and business platform. Production runs from the published GHCR image and updates through the normal Unraid Docker update workflow.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8189]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/JabbaDaHutt762/CNGI-Unraid-Templates/main/templates/cngi-core.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/JabbaDaHutt762/CNGI-Unraid-Templates/main/icons/cngi-icon-v2.webp</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>PostgreSQL and Authentik connectivity for full application functionality.</Requires>

  <Config Name="WebUI Port" Target="8189" Default="8189" Mode="tcp" Description="CNGI Core web interface port." Type="Port" Display="always" Required="true" Mask="false">8189</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/user/appdata/cngi-core" Mode="rw" Description="Persistent CNGI Core application data." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/cngi-core</Config>

  <Config Name="Timezone" Target="TZ" Default="America/New_York" Mode="" Description="Application timezone." Type="Variable" Display="always" Required="true" Mask="false">America/New_York</Config>
  <Config Name="Application Port" Target="PORT" Default="8189" Mode="" Description="Internal application listen port. Normally leave at 8189." Type="Variable" Display="advanced" Required="true" Mask="false">8189</Config>
  <Config Name="Database URL" Target="DATABASE_URL" Default="" Mode="" Description="PostgreSQL connection string for the canonical cngi_core database." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Authentik Base URL" Target="AUTHENTIK_BASE_URL" Default="" Mode="" Description="Base URL for Authentik." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Authentik Client ID" Target="AUTHENTIK_CLIENT_ID" Default="" Mode="" Description="Authentik OAuth/OIDC client ID." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Authentik Client Secret" Target="AUTHENTIK_CLIENT_SECRET" Default="" Mode="" Description="Authentik OAuth/OIDC client secret." Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Public Base URL" Target="PUBLIC_BASE_URL" Default="" Mode="" Description="Public/browser-facing URL for CNGI Core." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Session Secret" Target="SESSION_SECRET" Default="" Mode="" Description="Random secret used to sign CNGI Core browser sessions." Type="Variable" Display="always" Required="true" Mask="true"/>
</Container>
